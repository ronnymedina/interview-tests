# Copia este archivo a .env y pon tus valores reales.
# Se obtienen en el portal de Azure, en tu recurso de "Speech".

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Idioma que se evalua. en-US es el que tiene soporte mas completo.
SPEECH_LANGUAGE=en-US

# Postgres. En docker-compose la inyecta el servicio; en local apunta al Postgres
# que tengas corriendo.
DATABASE_URL=postgresql://review:review@localhost:5432/review_ingles

PORT=8000

# Gemini (modalidad de conversacion). Consigue una key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo del chat en formato "proveedor:modelo" (opcional; por defecto google_genai:gemini-2.5-flash).
# Cambiar de proveedor es cambiar esta linea, p. ej. openai:gpt-5-nano.
CHAT_MODEL=google_genai:gemini-2.5-flash

# LangSmith (observabilidad, opcional). Consigue la key en https://smith.langchain.com
# Las lee LangChain directamente del entorno; con ponerlas aqui se activan las trazas.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=review-ingles

# --- Piloto demo: tarifas, presupuesto y cuota (opcionales; defaults en config.py) ---
GEMINI_PRICE_INPUT_PER_1K=0.0003
GEMINI_PRICE_OUTPUT_PER_1K=0.0025
AZURE_SPEECH_PRICE_PER_SECOND=0.000278
DAILY_BUDGET_USD=3.0
TOTAL_BUDGET_USD=10.0
USER_CONVERSATION_QUOTA=3
USER_READING_QUOTA=10
MAX_ANSWER_SECONDS=30
MAX_QUESTIONS=5

# --- Rate limiting por IP (proteccion del servidor, opcionales; defaults en config.py) ---
# Topes de requests por minuto y por IP: global para todo el trafico, y mas estrictos para
# los endpoints caros (arrancan/avanzan la conversacion con LLM + Azure).
RATE_LIMIT_GLOBAL_PER_MIN=60
RATE_LIMIT_START_PER_MIN=10
RATE_LIMIT_ANSWER_PER_MIN=20
RATE_LIMIT_READING_PER_MIN=20

# --- Practica de lectura: ingesta del catalogo (opcionales; defaults en config.py) ---
# El catalogo se puebla con un job periodico, no scrapeando en vivo.
READING_INGEST_INTERVAL_HOURS=24
READING_INGEST_PAGES=3
READING_MIN_LEVEL=4
READING_MAX_LEVEL=7
READING_INGEST_MAX_ARTICLES=60
READING_INGEST_CONCURRENCY=5
READING_HTTP_TIMEOUT_SECONDS=20
READING_MAX_WORDS=120

# --- Logging estructurado (opcionales; defaults en config.py) ---
LOG_LEVEL=INFO
LOG_FORMAT=auto
